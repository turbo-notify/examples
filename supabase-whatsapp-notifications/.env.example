# Copy to supabase/functions/.env for local runs. For a hosted project, set them with
#   supabase secrets set --env-file supabase/functions/.env
# Never commit the real file.

# A Turbo Notify API key. Create it in the dashboard (API Keys) with only the messages:send scope.
TN_API_KEY=tn_live_replace_me

# A long random string. The same value goes in the Database Webhook's x-webhook-secret header.
WEBHOOK_SECRET=replace_me_with_a_long_random_string

# Optional. The number to send from: main (default), an alias, or a num_ id.
# TN_NUMBER=main

# Optional. Defaults to https://api.turbonotify.com
# TN_API_BASE_URL=https://api.turbonotify.com
