# ─── Turbo Notify ────────────────────────────────────────────────────────────
# Create an API key in the dashboard, under API Keys.
#
# This attendant uses two tools, and they need two scopes:
#   messages:read   for `get_message`      (reading the question)
#   messages:send   for `reply_to_message` (answering it)
#
# A key created without choosing any scope has full access and works as it is.
# If you pick scopes, pick those two: replying counts as sending, so a
# read-only key gets the question and cannot answer it.
TURBO_NOTIFY_API_KEY=

# The MCP server. The hosted one is the default; change it if you run your own.
TURBO_NOTIFY_MCP_URL=https://mcp.turbonotify.com/mcp

# Which of your numbers answers: `main`, or an extra number's alias.
#
# One webhook endpoint receives events for every number in your organization,
# so this is a filter: messages arriving on any other number are left alone.
# Leave it blank to answer on every number.
TURBO_NOTIFY_NUMBER_ALIAS=main

# The signing secret. You choose it, the dashboard does not generate one: put
# the same long random string here and in the "Secret de Assinatura" field
# beside the webhook URL in the dashboard.
#
# Leaving this empty DISABLES signature verification. That is fine while the
# webhook points at a tunnel on your laptop and nothing else can reach it. It is
# not fine anywhere a stranger can POST: without it, anyone who learns your URL
# can make the agent answer whatever they like, on your number, at your expense.
TURBO_NOTIFY_WEBHOOK_SECRET=
WEBHOOK_MAX_AGE_SECONDS=300

# ─── Model ───────────────────────────────────────────────────────────────────
# anthropic | openai | openai_compatible
MODEL_PROVIDER=anthropic
MODEL_ID=claude-sonnet-5

# Only for openai_compatible (OpenRouter, Groq, a local server).
MODEL_BASE_URL=

# Leave empty to use the provider's own conventional variable
# (ANTHROPIC_API_KEY / OPENAI_API_KEY).
MODEL_API_KEY=

# ─── Behaviour ───────────────────────────────────────────────────────────────
# Answer in groups too. Off by default: an attendant replying to every message
# in a busy group is a nuisance, and group sending is a paid feature.
ANSWER_GROUP_MESSAGES=false

# ─── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
