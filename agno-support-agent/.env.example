# ─── Turbo Notify ────────────────────────────────────────────────────────────
# Create an API key in the dashboard, under API Keys.
#
# This attendant uses three tools, and they need two scopes:
#   messages:read   for `get_message`           (reading the question)
#   messages:send   for `reply_to_message`      (answering it)
#                   and `send_typing_indicator` (showing "typing..." meanwhile)
#
# A key created with the "Full access" template works as it is. If you pick
# scopes, pick those two: replying counts as sending, so a read-only key gets
# the question and cannot answer it.
TURBO_NOTIFY_API_KEY=

# The MCP server. The hosted one is the default; change it if you run your own.
TURBO_NOTIFY_MCP_URL=https://mcp.turbonotify.com

# Which of your numbers answers: `main`, or an extra number's alias.
#
# One webhook endpoint receives events for every number in your organization,
# so this is a filter: messages arriving on any other number are left alone.
# Leave it blank to answer on every number.
TURBO_NOTIFY_NUMBER_ALIAS=main

# The signing secret. You choose it, the dashboard does not generate one: put
# the same long random string here and in the "Signing secret" field ("Secret
# de Assinatura" in Portuguese) beside the webhook URL in the dashboard.
#
# Leaving this empty makes the agent REFUSE TO START, unless
# TURBO_NOTIFY_ALLOW_UNSIGNED (below) is also set. Anywhere a stranger can
# reach your webhook URL, an unsigned agent lets them make it answer whatever
# they like, on your number and at your expense.
TURBO_NOTIFY_WEBHOOK_SECRET=
WEBHOOK_MAX_AGE_SECONDS=300

# Starts the agent anyway with TURBO_NOTIFY_WEBHOOK_SECRET empty. For local
# testing behind a private tunnel ONLY, where nothing else can reach the URL.
# Never set this true anywhere a stranger could POST to the endpoint.
TURBO_NOTIFY_ALLOW_UNSIGNED=false

# ─── Model ───────────────────────────────────────────────────────────────────
# anthropic | openai | openai_compatible
#
# With Docker, this must match the MODEL_EXTRA build argument (default
# anthropic), which controls which provider SDK is installed in the image:
# `MODEL_EXTRA=openai docker compose build` for openai here.
MODEL_PROVIDER=anthropic
MODEL_ID=claude-sonnet-5

# Only for openai_compatible (OpenRouter, Groq, a local server).
MODEL_BASE_URL=

# Leave empty to use the provider's own conventional variable
# (ANTHROPIC_API_KEY / OPENAI_API_KEY).
MODEL_API_KEY=

# ─── Behaviour ───────────────────────────────────────────────────────────────
# Answer in groups too. Off by default: an attendant replying to every message
# in a busy group is a nuisance, and group sending is a paid feature.
ANSWER_GROUP_MESSAGES=false

# ─── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
